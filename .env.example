# Server Port
PORT=3000

# Ethereum Sepolia RPC URL (e.g. Infura, Alchemy, or Public RPC)
ENS_RPC_URL=https://rpc.sepolia.org

# Discovery ENS Name published on Sepolia
ENS_DISCOVERY_NAME=devcon-router.eth

# Sepolia Wallet Private Key for ENS publishing (LOCAL SECRET ONLY - NEVER COMMIT)
SEPOLIA_PRIVATE_KEY=<local secret>

# OpenAI / OpenAI-compatible LLM API configuration
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Downstream agent request timeout in milliseconds
AGENT_TIMEOUT_MS=10000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
